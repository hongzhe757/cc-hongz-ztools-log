<?xml version="1.0" encoding="UTF-8"?>

<!-- @see http://www.cnblogs.com/hanfight/p/5721855.html -->
<!-- status : 这个用于设置log4j2自身内部的信息输出,可以不设置,当设置成trace时,会看到log4j2内部各种详细输出 monitorInterval : Log4j能够自动检测修改配置文件和重新配置本身, 设置间隔秒数。 -->
<Configuration status="WARN" monitorInterval="600">

	<Appenders>
		<!--这个输出控制台的配置 -->
		<Console name="Console" target="SYSTEM_OUT">
			<!-- 控制台只输出level及以上级别的信息(onMatch),其他的直接拒绝(onMismatch) -->
			<ThresholdFilter level="debug" onMatch="ACCEPT" onMismatch="DENY" />
			<!-- 输出日志的格式 -->
			<PatternLayout pattern="[%d{HH:mm:ss.SSS}][%highlight{%-5level}] %class{36}:%L %M - %msg%xEx%n" disableAnsi="false" />
		</Console>

		<!-- 请求报文独立文件 -->
		<File name="RequestFile" fileName="logs/message-in.log" append="false">
			<PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %c - %msg%n" />
		</File>

		<!-- 响应报文独立文件 -->
		<File name="ResponseFile" fileName="logs/message-out.log" append="false">
			<PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %c - %msg%n" />
		</File>

		<!-- JSON 报文独立文件：msg.json 路由到这里，报文内容本身为 JSON，原样输出 -->
		<File name="JsonFile" fileName="logs/message.json" append="false">
			<PatternLayout pattern="%msg%n" />
		</File>

		<!-- 主日志文件：普通业务 / 项目日志 -->
		<File name="MainFile" fileName="logs/app.log" append="false">
			<PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %c - %msg%n" />
		</File>
	</Appenders>

	<Loggers>
		<!-- 请求报文 logger：additivity=false 防止串到 root 主日志 -->
		<logger name="msg.in" level="INFO" additivity="false">
			<appender-ref ref="RequestFile" />
		</logger>
		<!-- 响应报文 logger -->
		<logger name="msg.out" level="INFO" additivity="false">
			<appender-ref ref="ResponseFile" />
		</logger>

		<!-- JSON 报文 logger -->
		<logger name="msg.json" level="INFO" additivity="false">
			<appender-ref ref="JsonFile" />
		</logger>

		<!-- 配置日志的根节点：普通日志同时输出控制台 + 主日志文件 -->
		<root level="debug">
			<appender-ref ref="Console" />
			<appender-ref ref="MainFile" />
		</root>
	</Loggers>

</Configuration>